    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "postcss": "8.5.33",
    "slugify": "1.6.9",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-cjs-interop": "4.1.1",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.22",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "react-twitter-embed": {
      "react": "19.3.1",
      "react-dom": "19.3.1"
    },
