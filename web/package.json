    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-toast": "1.3.1",
    "@react-router/node": "8.5.2",
    "@react-router/serve": "8.5.2",
    "@sanity/assist": "6.3.0",
    "@sanity/client": "8.17.0",
    "@sanity/code-input": "7.3.16",
    "@sanity/image-url": "2.2.0",
    "@sanity/locale-nb-no": "1.1.39",
    "@sanity/preview-url-secret": "4.1.5",
    "@sanity/react-loader": "2.3.0",
    "@sanity/table": "3.1.21",
    "@sanity/ui": "4.4.12",
    "@sanity/vision": "6.24.0",
    "@sanity/visual-editing": "6.2.1",
    "@sanity/webhook": "4.0.4",
    "@vercel/functions": "3.11.3",
    "@vercel/react-router": "1.3.7",
    "algoliasearch": "4.27.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csp-header": "6.4.0",
    "get-youtube-id": "1.0.1",
    "groq": "6.24.0",
    "isbot": "5.2.3",
    "lucide-react": "1.77.0",
    "motion": "14.14.0",
    "openai": "7.62.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-countdown": "2.3.6",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "react-instantsearch": "7.55.1",
    "react-refractor": "4.0.0",
    "react-router": "8.5.2",
    "react-twitter-embed": "4.0.4",
    "react-youtube": "10.1.0",
    "refractor": "5.0.0",
    "sanity": "6.24.0",
    "sanity-algolia": "1.1.0",
    "sanity-plugin-documents-pane": "4.1.25",
    "sanity-plugin-media": "6.6.3",
    "styled-components": "6.6.0",
    "tailwind-merge": "3.7.1",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@react-router/dev": "8.5.2",
    "@tailwindcss/typography": "0.5.20",
