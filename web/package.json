{
  "name": "web",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "prepare": "cd .. && npx husky web/.husky",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test": "TZ=UTC vitest run",
    "audio:generate": "tsx --env-file=.env scripts/generate-audio.ts",
    "summary:generate": "tsx --env-file=.env scripts/generate-summaries.ts",
    "typegen": "cd studio && sanity schema extract --enforce-required-fields --force && sanity typegen generate && cd .. && oxfmt utils/sanity/types/sanity.types.ts",
    "schema:deploy": "cd studio && sanity schemas deploy"
  },
  "dependencies": {
    "@getbrevo/brevo": "6.2.0",
    "@opengraphninja/react": "0.2.2",
    "@portabletext/react": "8.0.1",
