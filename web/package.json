{
  "name": "web",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "prepare": "cd .. && npx husky web/.husky",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test": "TZ=UTC vitest run",
    "audio:generate": "tsx --env-file=.env scripts/generate-audio.ts",
    "summary:generate": "tsx --env-file=.env scripts/generate-summaries.ts"
  },
  "dependencies": {
    "@getbrevo/brevo": "6.0.3",
    "@opengraphninja/react": "0.2.2",
    "@portabletext/react": "8.0.1",
    "@portabletext/types": "4.0.2",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-toast": "1.2.23",
    "@react-router/node": "8.3.1",
    "@react-router/serve": "8.3.1",
    "@sanity/client": "8.6.1",
    "@sanity/image-url": "2.1.1",
    "@sanity/preview-url-secret": "4.1.5",
    "@sanity/react-loader": "2.2.2",
    "@sanity/visual-editing": "6.1.2",
    "@sanity/webhook": "4.0.4",
    "@vercel/functions": "3.9.11",
    "@vercel/react-router": "1.3.6",
    "algoliasearch": "4.25.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csp-header": "6.4.0",
    "get-youtube-id": "1.0.1",
    "groq": "6.13.2",
    "isbot": "5.2.2",
    "lucide-react": "1.46.0",
    "motion": "13.3.0",
    "openai": "7.15.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-countdown": "2.3.6",
    "react-dom": "19.3.1",
    "react-instantsearch": "7.49.0",
    "react-refractor": "4.0.0",
    "react-router": "8.3.1",
    "react-twitter-embed": "4.0.4",
    "refractor": "5.0.0",
    "sanity-algolia": "1.1.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.3.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "9.1.7",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-cjs-interop": "4.0.3",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22.22",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "react-twitter-embed": {
      "react": "19.3.1",
      "react-dom": "19.3.1"
    },
    "@vercel/static-config": {
      "ajv": "^8.18.0"
    },
    "@vercel/react-router": {
      "@react-router/dev": "8.3.1",
      "@react-router/node": "8.3.1"
    }
  }
}
